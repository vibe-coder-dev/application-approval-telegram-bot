# Application Bot Configuration

# Required settings
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_admin_telegram_id_here

# Database settings
DB_TYPE=postgresql  # or 'sqlite'

# PostgreSQL settings (used when DB_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=application_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SQLite settings (used when DB_TYPE=sqlite)
SQLite_DB_PATH=data/bot.db

# Application settings
UPLOAD_DIR=uploads
DEFAULT_LANGUAGE=en

# Available languages (comma separated)
AVAILABLE_LANGUAGES=en,ru
